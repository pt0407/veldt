# depths.veldt — a roguelite crawl: grab gold, dodge hunters, reach the exit
# alive. game_step is the grown move policy — the engine handles chase,
# combat rolls, scoring. HP hits 0 = devoured; reach > = escaped.

grow fn game_step(px: int, py: int, ex: int, ey: int, maze: dict)
        test game_step(1, 1, 19, 9, dict()) == [1, 0] {
    # seed policy: greedy toward target, horizontal bias
    let dx = 0
    let dy = 0
    if ex > px { dx = 1 }
    if ex < px { dx = -1 }
    if ey > py and dx == 0 { dy = 1 }
    if ey < py and dx == 0 { dy = -1 }
    return [dx, dy]
}

# --- world ---
let maze = maze_gen(21, 11, "#")
let px = 1
let py = 1
let ex = 19
let ey = 9
let score = 0
let hp = 100
let turns = 0
let won = false

# gold scattered on open floor
let gold = [[5, 5], [10, 3], [13, 7], [7, 9], [16, 4]]

# two hunters patrolling
let h1 = dict()
h1["x"] = 19
h1["y"] = 1
let h2 = dict()
h2["x"] = 10
h2["y"] = 9

# --- the crawl ---
while turns < 60 and not won and hp > 0 {
    # target: nearest gold, else the exit when gold is gone
    let tx = ex
    let ty = ey
    let best_d = 999
    let gi = 0
    while gi < gold.len() {
        let g = gold[gi]
        let d = abs(g[0] - px) + abs(g[1] - py)
        if d < best_d {
            best_d = d
            tx = g[0]
            ty = g[1]
        }
        gi = gi + 1
    }

    # player move via the grown policy
    let step = game_step(px, py, tx, ty, maze)
    let nx = px + step[0]
    let ny = py + step[1]
    if canvas_get(maze, nx, ny) != "#" {
        px = nx
        py = ny
    }

    # grab gold — +100 score, +15 hp
    let remaining = []
    gi = 0
    while gi < gold.len() {
        let g = gold[gi]
        if g[0] == px and g[1] == py {
            score = score + 100
            hp = min(100, hp + 15)
        } else {
            remaining.append(g)
        }
        gi = gi + 1
    }
    gold = remaining

    # hunters: chase on line-of-sight, wander in the dark
    let hunters = [h1, h2]
    let hi = 0
    while hi < hunters.len() {
        let h = hunters[hi]
        if los(maze, h["x"], h["y"], px, py, "#") {
            let path = astar(maze, h["x"], h["y"], px, py, " ")
            if path != null and path.len() > 1 {
                h["x"] = path[1][0]
                h["y"] = path[1][1]
            }
        } else {
            let dir = rand_range(1, 4)
            let hx2 = h["x"]
            let hy2 = h["y"]
            if dir == 1 { hx2 = hx2 + 1 }
            if dir == 2 { hx2 = hx2 - 1 }
            if dir == 3 { hy2 = hy2 + 1 }
            if dir == 4 { hy2 = hy2 - 1 }
            if canvas_get(maze, hx2, hy2) != "#" {
                h["x"] = hx2
                h["y"] = hy2
            }
        }
        # adjacent-or-same cell = the hunter bites
        let dist = abs(h["x"] - px) + abs(h["y"] - py)
        if dist <= 1 {
            hp = hp - rand_range(4, 14)
        }
        hi = hi + 1
    }
    h1 = hunters[0]
    h2 = hunters[1]

    if px == ex and py == ey { won = true }
    turns = turns + 1
}

# --- render + HUD ---
let scene = canvas_set(maze, px, py, "@")
scene = canvas_set(scene, h1["x"], h1["y"], "E")
scene = canvas_set(scene, h2["x"], h2["y"], "E")
scene = canvas_set(scene, ex, ey, ">")
let gi2 = 0
while gi2 < gold.len() {
    scene = canvas_set(scene, gold[gi2][0], gold[gi2][1], "*")
    gi2 = gi2 + 1
}
let hud = ui_box(scene, 0, 0, 21, 3, "DEPTHS")
hud = ui_label(hud, 2, 1, "HP")
hud = ui_bar(hud, 5, 1, 10, hp, 100, "|")
hud = ui_label(hud, 2, 2, "SCORE " + score + "  T" + turns)
canvas_print(hud)

if won {
    print("escaped the depths — " + score + " gold in " + turns + " turns")
} else {
    if hp <= 0 {
        print("devoured by the hunters — score " + score)
    } else {
        print("lost in the dark — score " + score)
    }
}
