# dungeon.veldt — the game pillar end-to-end:
# maze_gen procgen + astar pathfinding + canvas render + ui HUD + bt AI

# --- 1. generate a maze ---
let m = maze_gen(21, 11, "#")

# --- 2. place player + exit ---
let px = 1
let py = 1
let ex = 19
let ey = 9
let m2 = canvas_set(m, px, py, "@")
let m3 = canvas_set(m2, ex, ey, ">")

# --- 3. enemy AI — a behavior tree that chases if in LOS, wanders else ---
let enemy = dict()
enemy["x"] = 19
enemy["y"] = 1
enemy["hp"] = 60

let chase = ["seq",
    ["act", fn(e) { return los(m, e["x"], e["y"], 1, 1, "#") }],
    ["act", fn(e) { return true }]]

let bt_result = bt_tick(chase, enemy)
if bt_result {
    let path = astar(m3, enemy["x"], enemy["y"], px, py, " ")
    if path != null {
        # move one step along the path
        let step = path[1]
        m3 = canvas_set(m3, step[0], step[1], "E")
    }
}

# --- 4. HUD ---
let hud = ui_box(m3, 0, 0, 21, 3, "DUNGEON")
hud = ui_label(hud, 2, 1, "HP")
hud = ui_bar(hud, 6, 1, 12, enemy["hp"], 100, "|")
hud = ui_label(hud, 2, 2, "POS " + px + "," + py)

canvas_print(hud)

# --- 5. path check ---
let path_to_exit = astar(m3, px, py, ex, ey, " ")
if path_to_exit != null {
    print("path to exit: " + path_to_exit.len() + " steps")
} else {
    print("no path — maze is sealed")
}
