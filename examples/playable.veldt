# playable.veldt — a REAL-TIME game driven by the new 2D engine builtins.
# WASD/arrows move @ — a hunter chases you, grab coins, reach the exit.
# game_new/entity/ent_move/collide/keys/game_frame/game_running — the
# browser is the viewport + input device; this loop runs server-side.

let g = game_new(30, 15)

let player = entity("player", 2, 7, "hero")
let hunter = entity("hunter", 26, 7, "hunter")
let exit = entity("exit", 28, 12, "exit")
let gold = [
    entity("coin", 8, 4, "coin"),
    entity("coin", 15, 9, "coin"),
    entity("coin", 22, 3, "coin"),
    entity("coin", 6, 12, "coin"),
]
let hp = 100
let score = 0
let won = false

# the real-time loop — browser input via keys(), frames via game_frame()
while game_running() and not won and hp > 0 {
    let k = keys()
    let dx = 0
    let dy = 0
    if k.contains("left") { dx = -1 }
    if k.contains("right") { dx = 1 }
    if k.contains("up") { dy = -1 }
    if k.contains("down") { dy = 1 }
    player = ent_move(player, dx, dy)

    # clamp to the world
    let px = player["x"]
    let py = player["y"]
    if px < 0 { player = ent_move(player, 1, 0) }
    if px > g["w"] - 1 { player = ent_move(player, -1, 0) }
    if py < 0 { player = ent_move(player, 0, 1) }
    if py > g["h"] - 1 { player = ent_move(player, 0, -1) }
    px = player["x"]
    py = player["y"]

    # hunter chases at half speed — it hunts, you outrun
    let hx = hunter["x"]
    let hy = hunter["y"]
    let hdx = 0.0
    let hdy = 0.0
    if hx < px { hdx = 0.5 } else { if hx > px { hdx = -0.5 } }
    if hy < py { hdy = 0.5 } else { if hy > py { hdy = -0.5 } }
    hunter = ent_move(hunter, hdx, hdy)

    # contact = it bites
    if collide(player, hunter) {
        hp = hp - 3
    }

    # grab coins
    let remaining = []
    let gi = 0
    while gi < gold.len() {
        let c = gold[gi]
        if collide(player, c) {
            score = score + 100
            hp = min(100, hp + 12)
        } else {
            remaining.append(c)
        }
        gi = gi + 1
    }
    gold = remaining

    if collide(player, exit) { won = true }

    # emit the frame — the browser paints it
    let hud = dict()
    hud["hp"] = hp
    hud["score"] = score
    hud["gold"] = gold.len()
    let scene = [player, hunter, exit]
    gi = 0
    while gi < gold.len() {
        scene.append(gold[gi])
        gi = gi + 1
    }
    game_frame(g, scene, hud)
    sleep(80)
}

let out = dict()
out["hp"] = hp
out["score"] = score
out["won"] = won
let scene2 = [player, hunter, exit]
gi = 0
while gi < gold.len() {
    scene2.append(gold[gi])
    gi = gi + 1
}
game_frame(g, scene2, out)
if won { print("escaped! score " + score) }
else { if hp <= 0 { print("devoured — score " + score) } else { print("session over") } }
