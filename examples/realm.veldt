# realm.veldt — generated by `veldt game new`
# A complete playable game: maze + player + exit + enemy AI + HUD +
# turn loop. `game_step` is grown — evolve it with
#   veldt agent "improve game_step"   or   veldt evolve

# --- the evolve-able core: pick the player's next move ---
# (x, y) -> [dx, dy] — the Gardener breeds this policy toward the exit
grow fn game_step(px: int, py: int, ex: int, ey: int, maze: dict)
        test game_step(1, 1, 19, 9, dict()) == [1, 0] {
    # seed policy: greedy toward the exit (right/down bias)
    let dx = 0
    let dy = 0
    if ex > px { dx = 1 }
    if ex < px { dx = -1 }
    if ey > py and dx == 0 { dy = 1 }
    if ey < py and dx == 0 { dy = -1 }
    return [dx, dy]
}

# --- generate the level ---
let maze = maze_gen(21, 11, "#")
let px = 1
let py = 1
let ex = 19
let ey = 9

let enemy = dict()
enemy["x"] = 19
enemy["y"] = 1
enemy["hp"] = 60

# enemy AI — a behavior tree: chase if in LOS, wander else
let chase = ["seq",
    ["act", fn(e) { return los(maze, e["x"], e["y"], px, py, "#") }],
    ["act", fn(e) { return true }]]

# --- the game loop ---
let turns = 0
let won = false
while turns < 30 and not won {
    # player move via the grown policy
    let step = game_step(px, py, ex, ey, maze)
    let nx = px + step[0]
    let ny = py + step[1]
    # walkable? (maze_gen walls are "#" — canvas_get reads the cell)
    if canvas_get(maze, nx, ny) != "#" {
        px = nx
        py = ny
    }
    if px == ex and py == ey { won = true }

    # enemy turn — chase via astar if the tree fires
    if bt_tick(chase, enemy) {
        let path = astar(maze, enemy["x"], enemy["y"], px, py, " ")
        if path != null and path.len() > 1 {
            enemy["x"] = path[1][0]
            enemy["y"] = path[1][1]
        }
    }

    turns = turns + 1
}

# --- render + HUD ---
let scene = canvas_set(maze, px, py, "@")
scene = canvas_set(scene, enemy["x"], enemy["y"], "E")
scene = canvas_set(scene, ex, ey, ">")
let hud = ui_box(scene, 0, 0, 21, 3, "realm")
hud = ui_label(hud, 2, 1, "TURNS " + turns)
hud = ui_bar(hud, 2, 2, 12, enemy["hp"], 100, "|")
canvas_print(hud)

if won {
    print("reached the exit in " + turns + " turns!")
} else {
    print("didn't make it — evolve game_step for a smarter policy")
}
