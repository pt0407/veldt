# === FLOATS ===
print("=== Floats ===")
let pi = 3.14159
let radius = 5.0
let area = pi * radius * radius
print("pi = " + pi)
print("radius = " + radius)
print("area = " + area)
let temp_c = 25.5
let temp_f = temp_c * 9.0 / 5.0 + 32.0
print(temp_c + "C = " + temp_f + "F")
print("")

# === DICTS ===
print("=== Dicts ===")
let scores = dict()
scores = scores.put("Alice", 95)
scores = scores.put("Bob", 82)
scores = scores.put("Charlie", 78)
print("Scores: " + scores)
print("Alice's score: " + scores.get("Alice"))
print("Has Dave? " + scores.has("Dave"))
print("Keys: " + scores.keys())
print("Count: " + scores.len())
print("")

# === FILE I/O ===
print("=== File I/O ===")
let result = write_file("/tmp/veldt_test.txt", "Hello from Veldt!\nLine 2 here.\n")
print("Write success: " + result)
let content = read_file("/tmp/veldt_test.txt")
print("Read back: " + content)
let lines = content.split("\n")
print("Line count: " + len(lines))
print("")

