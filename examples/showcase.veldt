# === SMART EVOLUTION ===
print("=== Smart Evolution ===")
print("Functions grown with efficiency-aware fitness:")
print("Mutants that pass tests AND use fewer steps get higher fitness.")
print("Smaller code also gets a bonus.")
print("")
print("Run 'veldt evolve 5' to see fitness scores that reward efficiency.")

# === GROW functions for evolution ===
grow fn fast_sum(nums: list<int>) test fast_sum([1, 2, 3, 4, 5]) == 15 {
    let total = 0
    for n in nums {
        total = total + n
    }
    return total
}

grow fn fast_max(nums: list<int>) test fast_max([3, 7, 2, 9, 1]) == 9 {
    let best = nums[0]
    for n in nums {
        if n > best {
            best = n
        }
    }
    return best
}

grow fn circle_area(r: float) test circle_area(2.0) == 12.56636 {
    return 3.14159 * r * r
}

grow fn c_to_f(c: float) test c_to_f(0.0) == 32.0, c_to_f(100.0) == 212.0 {
    return c * 9.0 / 5.0 + 32.0
}

grow fn word_count(text: str) test word_count("hello world foo") == 3 {
    let words = text.split(" ")
    return len(words)
}

print("")
print("All 5 features working!")
