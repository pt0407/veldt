# snake.veldt — headless snake AI via bfs + canvas render
let c = canvas_new(20, 10)
let c2 = canvas_set(c, 15, 7, "*")
let c3 = canvas_set(c2, 4, 2, "*")
let snake = [[3, 3], [2, 3], [1, 3]]

let steps = 0
while steps < 8 {
    let head = snake[0]
    let path = bfs(c3, head[0], head[1], 15, 7, " ")
    if path != null and path.len() > 1 {
        let next = path[1]
        # prepend new head, drop the tail
        let new_snake = [[next[0], next[1]]]
        let i = 0
        while i < snake.len() - 1 {
            new_snake.append(snake[i])
            i = i + 1
        }
        snake = new_snake
    }
    steps = steps + 1
}

let c4 = c3
let i = 0
while i < snake.len() {
    let p = snake[i]
    let ch = "o"
    if i == 0 { ch = "@" }
    c4 = canvas_set(c4, p[0], p[1], ch)
    i = i + 1
}
canvas_print(c4)
print("snake at " + snake[0][0] + "," + snake[0][1] + " after " + steps + " steps")
