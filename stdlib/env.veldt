# stdlib/env — environment + process access for veldt
# `import "env"` then env::get("PATH"), env::args(), env::var_or(k, d)…

fn get(name: str) { return env(name) }
fn var_or(name: str, default: str) {
    let v = env(name)
    if v == "" { v = default }
    return v
}
fn has(name: str) { return env(name) != "" }
fn args_list() { return args() }
