# stdlib/math — math helpers
fn clamp(x: int, lo: int, hi: int) {
    if x < lo { return lo }
    if x > hi { return hi }
    return x
}
fn sign(x: int) {
    if x < 0 { return -1 }
    if x > 0 { return 1 }
    return 0
}
fn sum(xs: list) {
    let t = 0
    for n in xs { t = t + n }
    return t
}
fn avg(xs: list) {
    if xs.len() == 0 { return 0 }
    return sum(xs) / xs.len()
}
